{
  "name": "azzo-room",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n WEB,GAME -c cyan,magenta \"npm run dev -w @azzo/web\" \"npm run dev -w @azzo/game-server\"",
    "dev:web": "npm run dev -w @azzo/web",
    "dev:server": "npm run dev -w @azzo/game-server",
    "build:web": "npm run build -w @azzo/web",
    "build:server": "npm run build -w @azzo/game-server",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && npm run build:server",
    "build": "npm run build:server && npm run build:web",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:db": "bash scripts/test-db.sh",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{js,ts,json}\" \"tests/**/*.{ts,mjs}\" package.json playwright.config.ts",
    "test:production": "node --test tests/production/*.test.mjs",
    "check:production": "node scripts/check-production.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
