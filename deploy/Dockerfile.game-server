# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/game-server/package.json apps/game-server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/avatar/package.json packages/avatar/package.json
RUN --mount=type=secret,id=npm_ca,target=/tmp/npm-ca.pem,required=false \
    if [ -f /tmp/npm-ca.pem ]; then export NODE_EXTRA_CA_CERTS=/tmp/npm-ca.pem npm_config_cafile=/tmp/npm-ca.pem; fi; \
    npm ci --workspace @azzo/game-server --workspace @azzo/avatar --include-workspace-root=false --include=dev
COPY packages/avatar packages/avatar
COPY apps/game-server apps/game-server
RUN npm run build:server && npm prune --omit=dev --workspace @azzo/game-server --workspace @azzo/avatar --include-workspace-root=false

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production PORT=2567 ALLOW_DEV_GUESTS=false
WORKDIR /app
COPY --from=build --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/packages/avatar ./packages/avatar
COPY --from=build --chown=node:node /app/apps/game-server/package.json ./apps/game-server/package.json
COPY --from=build --chown=node:node /app/apps/game-server/dist ./apps/game-server/dist
USER node
EXPOSE 2567
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/game-server/dist/index.js"]
