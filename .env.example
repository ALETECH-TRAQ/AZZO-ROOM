# Frontend — apps/web/.env.local (public configuration)
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:2567
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LiveKit — apps/web/.env.local (server-side only; real values required for local JWT signing)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional local demo only. Both demo paths are blocked in production.
ENABLE_DEV_DEMO_TOKENS=true

# Game server — export in terminal or configure the hosting process
SUPABASE_URL=
SUPABASE_ANON_KEY=
PORT=2567
ALLOW_DEV_GUESTS=true

# Game server em produção: URL exata da Vercel, sem wildcard
ALLOWED_ORIGINS=
